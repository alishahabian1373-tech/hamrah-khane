<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>همراه خانه</title>
<style>
:root{--bg:#eef2f5;--cd:#fff;--tx:#17212b;--mu:#667583;--ac:#0e8c8c;--on:#fff;--wn:#c77d00;--rd:#c23b32;--ln:#dbe3e9}
@media(prefers-color-scheme:dark){:root{--bg:#0f1820;--cd:#17232d;--tx:#e6edf2;--mu:#8fa0ad;--ac:#2fc4c0;--on:#06201f;--wn:#f0b429;--rd:#ff7b70;--ln:#243441}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.7 Vazirmatn,Tahoma,system-ui,sans-serif;padding-top:env(safe-area-inset-top,0px);padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))}
header{padding:22px 18px 6px}
h1{margin:0;font-size:26px;font-weight:800}
.hr{display:flex;justify-content:space-between;align-items:center;gap:8px}
.cb{background:var(--cd);color:var(--ac);border:1.5px solid var(--ln);padding:6px 14px;font-size:13px}
header p{margin:0;color:var(--mu);font-size:14px}
header .al{color:var(--wn);font-weight:700;margin-top:4px}
main{padding:12px 14px}
.fm{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.fm>*{flex:1 1 40%;min-width:0}
.fm button{flex:1 1 100%}
.fm.s button{flex:0 0 auto}
.fm>.jd{flex:1 1 100%;display:flex;gap:6px}
.jd select{flex:1;min-width:0;padding:10px 6px}
.sdw .jd{display:flex;gap:6px}
.jd input[type=text]{flex:1;min-width:0;text-align:center}
.jd b{color:var(--mu)}
.ck{display:flex;align-items:center;gap:8px;flex:1}
.ck input{width:22px;height:22px;accent-color:var(--ac);padding:0}
.wk{display:flex;gap:4px;margin-bottom:14px}
.wk button{flex:1;min-width:0;padding:8px 0;font-size:12px;border-radius:10px;background:var(--cd);color:var(--tx);font-weight:600}
.wk .on{background:var(--ac);color:var(--on)}
.wk .td{box-shadow:inset 0 -3px 0 var(--wn)}
.fm>.ds{flex:1 1 100%;display:flex;flex-wrap:wrap;gap:6px}
.ds label{cursor:pointer}
.ds input{position:absolute;opacity:0;width:0;height:0}
.ds span{display:block;padding:6px 12px;border-radius:99px;border:1.5px solid var(--ln);background:var(--cd);font-size:14px}
.ds input:checked+span{background:var(--ac);color:var(--on);border-color:var(--ac)}
.ds input:focus-visible+span{outline:2px solid var(--ac);outline-offset:1px}
input,select{font:inherit;color:var(--tx);background:var(--cd);border:1.5px solid var(--ln);border-radius:10px;padding:10px 12px}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--ac);outline-offset:1px}
button{font:inherit;border:0;cursor:pointer;color:var(--on);background:var(--ac);border-radius:99px;padding:10px 20px;font-weight:700}
.gh{background:none;color:var(--mu);border:1.5px solid var(--ln);display:block;margin:14px auto}
.it{display:flex;align-items:center;gap:8px;background:var(--cd);border-radius:14px;padding:10px 14px;margin-bottom:8px}
.it label{flex:1;display:flex;align-items:center;gap:12px;min-width:0}
.it input[type=checkbox]{width:22px;height:22px;accent-color:var(--ac);flex:none;padding:0}
.it small{display:block;color:var(--mu);font-size:13px;line-height:1.5}
.it>span{flex:1;min-width:0}
.dn span{text-decoration:line-through;opacity:.5}
.x{background:none;color:var(--mu);padding:0 6px;font-size:22px}
em{font-style:normal;font-size:13px;font-weight:700;color:var(--mu)}
em.now{color:var(--wn)}em.late{color:var(--rd)}
.sum{background:var(--ac);color:var(--on);border-radius:20px;padding:16px 18px;margin-bottom:14px}
.sum small{opacity:.8}.sum b{display:block;font-size:28px}
.bar{display:flex;gap:8px;align-items:center;font-size:13px;margin-top:6px}
.bar span{width:70px;flex:none}
.bar i{height:6px;border-radius:3px;background:var(--on);opacity:.55}
.bar em{color:var(--on);margin-inline-start:auto}
.em{text-align:center;color:var(--mu);padding:30px 0}
nav{position:fixed;inset:auto 0 0;display:flex;background:var(--cd);border-top:1px solid var(--ln);padding-bottom:env(safe-area-inset-bottom,0px)}
nav button{flex:1;background:none;color:var(--mu);border-radius:0;padding:14px 0;border-top:3px solid transparent}
nav .on{color:var(--ac);border-top-color:var(--ac)}
</style>
</head>
<body>
<div id="app"></div>
<nav>
<button data-t="shop" onclick="go(this)">خرید</button>
<button data-t="exp" onclick="go(this)">هزینه</button>
<button data-t="rem" onclick="go(this)">یادآور</button>
<button data-t="chore" onclick="go(this)">کارها</button>
</nav>
<script>
const g=id=>document.getElementById(id);
let S;try{S=JSON.parse(localStorage.getItem('hk'))}catch(e){}
S=S||{shop:[],exp:[],rem:[],chore:[]};
if(S.cm==null)S.cm=1;
if(S.cal==null)S.cal='j';
let tab='shop',T;
const save=()=>{try{localStorage.setItem('hk',JSON.stringify(S))}catch(e){}monthly()};
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const fa=n=>Number(n).toLocaleString('fa-IR').replace(/٬/g,',');
const iso=()=>new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10);
const dt=s=>new Date(s+'T12:00:00');
const diff=(a,b)=>Math.round((dt(a)-dt(b))/864e5);
const jd=(s,o)=>dt(s).toLocaleDateString(S.cal=='g'?'fa-IR-u-ca-gregory':'fa-IR-u-ca-persian',o);
const MK={year:'numeric',month:'numeric'};
const esc=s=>String(s).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
const num=s=>+String(s).replace(/[۰-۹]/g,d=>d.charCodeAt(0)-1776).replace(/[,٬]/g,'')||0;
const val=id=>g(id).value.trim();
function fmt(el){const p=el.selectionStart||0,before=el.value.slice(0,p).replace(/[^\d۰-۹]/g,'').length;
const d=el.value.replace(/[۰-۹]/g,x=>x.charCodeAt(0)-1776).replace(/\D/g,'').replace(/^0+(?=\d)/,'').slice(0,12);
el.value=d?fa(+d):'';let c=0,i=0;for(;i<el.value.length&&c<before;i++)if(/[\d۰-۹]/.test(el.value[i]))c++;
try{el.setSelectionRange(i,i)}catch(e){}}
function lim(el,mx){let v=String(el.value).replace(/[۰-۹]/g,d=>d.charCodeAt(0)-1776).replace(/\D/g,'').slice(0,2);if(v!==''&&+v>mx)v=String(mx);el.value=v}
const gtm=()=>String(Math.min(23,num(val('th')))).padStart(2,'0')+':'+String(Math.min(59,num(val('tn')))).padStart(2,'0');
const CATS=['خوراک','قبض','حمل‌ونقل','سلامت','پوشاک','تفریح','سایر'];
const RT=['قبض','قسط','چک','سایر'];
const ED=[1,2,3,4,5,6,7,14,30].map(n=>[n,'یادآوری '+fa(n)+' روز زودتر']);
const ed=x=>x.e==null?1:x.e;
const MN=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
const fy=n=>n.toLocaleString('fa-IR',{useGrouping:false});
const o3=a=>a.year*372+(a.month-1)*31+a.day;
function j2g(y,m,d){d=Math.min(d,m<7?31:30);
const t=new Date(y+621,2,21,12);t.setDate(t.getDate()+(m<7?(m-1)*31:186+(m-7)*30)+d-1);
const g=o3({year:y,month:m,day:d});
for(let i=0;i<9;i++){const c=o3(jp(t));if(c==g)break;t.setDate(t.getDate()+(c<g?1:-1))}
if(jp(t).month!=m)t.setDate(t.getDate()-1);
return new Date(t.getTime()-t.getTimezoneOffset()*6e4).toISOString().slice(0,10)}
const GN=['ژانویه','فوریه','مارس','آوریل','مه','ژوئن','ژوئیه','اوت','سپتامبر','اکتبر','نوامبر','دسامبر'];
const cp=d=>S.cal=='g'?{year:d.getFullYear(),month:d.getMonth()+1,day:d.getDate()}:jp(d);
const dimc=(y,m)=>S.cal=='g'?new Date(y,m,0).getDate():dim(y,m);
const toIso=(y,m,d)=>{if(S.cal!='g')return j2g(y,m,d);d=Math.min(d,dimc(y,m));return y+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0')};
const dim=(y,m)=>m<7?31:m<12?30:jp(dt(j2g(y,12,30))).day==30?30:29;
function fixd(){const s=g('wd'),o=+s.value,n=dimc(+g('wy').value,+g('wm').value);s.innerHTML=Array.from({length:n},(_,i)=>`<option value=${i+1}>${fa(i+1)}</option>`).join('');s.value=Math.min(o,n)}
const jpick=()=>{const p=cp(dt(T)),so=(v,l,s)=>`<option value=${v}${s?' selected':''}>${l}</option>`;
return `<div class=jd><select id=wd>${Array.from({length:dimc(p.year,p.month)},(_,i)=>so(i+1,fa(i+1),i+1==p.day)).join('')}</select><select id=wm onchange="fixd()">${(S.cal=='g'?GN:MN).map((n,i)=>so(i+1,n,i+1==p.month)).join('')}</select><select id=wy onchange="fixd()">${[-1,0,1,2,3,4,5].map(i=>so(p.year+i,fy(p.year+i),!i)).join('')}</select></div>`};
const RP=[[0,'یک‌بار'],[1,'هر روز'],[7,'هر هفته']];
const opts=a=>a.map(x=>`<option>${x}</option>`).join('');
const xb=(k,id)=>`<button class=x aria-label="حذف" onclick="rm('${k}','${id}')">×</button>`;
const empty=t=>`<p class=em>${t}</p>`;
const DAYS=[[5,'جمعه'],[6,'شنبه'],[0,'یکشنبه'],[1,'دوشنبه'],[2,'سه‌شنبه'],[3,'چهارشنبه'],[4,'پنجشنبه']];
let cd=new Date().getDay();
const isT=()=>cd==new Date().getDay(),onDay=x=>!x.ds||x.ds.includes(cd);
const sub=x=>x.ds?(x.ds.length==7?'هر روز':DAYS.filter(d=>x.ds.includes(d[0])).map(d=>d[1]).join('، ')):RP.find(p=>p[0]==x.r)[1];
const strip=()=>`<div class=wk>${DAYS.map(d=>`<button class="${d[0]==cd?'on':''}${d[0]==new Date().getDay()?' td':''}" onclick="cd=${d[0]};render()">${d[1]}</button>`).join('')}</div>`;
const chips=()=>`<div class=ds>${DAYS.map(d=>`<label><input type=checkbox value=${d[0]}${d[0]==cd?' checked':''}><span>${d[1]}</span></label>`).join('')}</div>`;
const done=c=>c.l&&(c.r==0||diff(T,c.l)<c.r);
const dl=x=>{const n=diff(x.w,T);return n<0?[fa(-n)+' روز گذشته','late']:n==0?['امروز','now']:[fa(n)+' روز مانده','']};

const V={
shop:()=>`<div class=fm><input id=t placeholder="چی لازم داری؟"><div class=jd><label class=ck><input type=checkbox id=al onchange="g('sd').style.display=this.checked?'block':'none'"><span>آلارم</span></label><input id=tn onfocus="this.select()" onclick="this.select()" oninput="lim(this,59)" onblur="this.value=this.value.padStart(2,'0')" type=text inputmode=numeric maxlength=2 dir=ltr placeholder="دقیقه" value="00" aria-label="دقیقه"><b>:</b><input id=th onfocus="this.select()" onclick="this.select()" oninput="lim(this,23);if(this.value.length>=2)g('tn').focus()" onblur="this.value=this.value.padStart(2,'0')" type=text inputmode=numeric maxlength=2 dir=ltr placeholder="ساعت" value="09" aria-label="ساعت"></div><div id=sd class=sdw style="display:none;flex:1 1 100%">${jpick()}</div><button onclick="add('shop')">افزودن</button></div>`+
(S.shop.length?S.shop.slice().sort((a,b)=>a.ok-b.ok).map(x=>`<div class="it ${x.ok?'dn':''}"><label><input type=checkbox ${x.ok?'checked':''} onchange="tg('shop','${x.id}')"><span>${esc(x.t)}${x.al?`<small>آلارم ${jd(x.w,{day:'numeric',month:'long'})}، ${ft(x.tm)}</small>`:''}</span></label>${xb('shop',x.id)}</div>`).join('')+(S.shop.some(x=>x.ok)?`<button class=gh onclick="clr()">پاک کردن خریده‌شده‌ها</button>`:''):empty('لیست خالیه. اولین قلم رو بنویس.')),

exp:()=>{
const mk=jd(T,MK),m=S.exp.filter(e=>jd(e.w,MK)==mk),tot=m.reduce((s,e)=>s+e.a,0),by={};
m.forEach(e=>by[e.c]=(by[e.c]||0)+e.a);
return `<div class=sum><small>جمع هزینه ${jd(T,{month:'long'})}</small><b>${fa(tot)} تومان</b>`+
Object.entries(by).sort((a,b)=>b[1]-a[1]).map(([c,v])=>`<div class=bar><span>${c}</span><i style="width:${v/tot*45}%"></i><em>${fa(v)}</em></div>`).join('')+`</div>`+
`<div class=fm><input oninput="fmt(this)" id=a type=text inputmode=numeric placeholder="مبلغ به تومان"><select id=c>${opts(CATS)}</select><input id=t placeholder="توضیح (اختیاری)"><button onclick="add('exp')">ثبت هزینه</button></div>`+
(S.exp.length?S.exp.slice().sort((a,b)=>b.w.localeCompare(a.w)).slice(0,50).map(e=>`<div class=it><span>${esc(e.c)}${e.t?'، '+esc(e.t):''}<small>${jd(e.w,{day:'numeric',month:'long'})}</small></span><b>${fa(e.a)}</b>${xb('exp',e.id)}</div>`).join(''):empty('هنوز هزینه‌ای ثبت نشده.'))},

rem:()=>`<div class=it><label><input type=checkbox ${S.cm?'checked':''} onchange="tcm()"><span>یادآوری آخر ماه برای چک‌های ماه بعد<small>${S.cm?'روشن':'خاموش'}</small></span></label></div><div class=fm><input id=t placeholder="عنوان، مثلاً قسط وام"><select id=c>${opts(RT)}</select>${jpick()}<input oninput="fmt(this)" id=m type=text inputmode=numeric placeholder="مبلغ (اختیاری)"><select id=e>${ED.map(p=>`<option value=${p[0]}${p[0]==1?' selected':''}>${p[1]}</option>`).join('')}</select>${alr()}<button onclick="add('rem')">افزودن یادآور</button></div>`+
(S.rem.length?S.rem.slice().sort((a,b)=>a.ok-b.ok||a.w.localeCompare(b.w)).map(x=>{const[l,c]=dl(x);return `<div class="it ${x.ok?'dn':''}"><label><input type=checkbox ${x.ok?'checked':''} onchange="tg('rem','${x.id}')"><span>${esc(x.t)}<small>${esc(x.c)}، ${jd(x.w,{day:'numeric',month:'long',year:'numeric'})}${x.m?'، '+fa(x.m)+' تومان':''}، ${ed(x)?fa(ed(x))+' روز زودتر':'همان روز'}${x.al?'، آلارم '+ft(x.tm):''}</small></span></label>${x.ok?'':`<em class="${c}">${l}</em>`}${xb('rem',x.id)}</div>`}).join(''):empty('یادآوری ثبت نشده. قبض و قسط‌هات رو اضافه کن.')),

chore:()=>strip()+`<div class=fm><input id=t placeholder="کار خونه"><select id=c><option value=one>فقط ${DAYS.find(d=>d[0]==cd)[1]}</option><option value=all>هر روز</option></select>${alr()}<button onclick="add('chore')">افزودن</button></div>`+
(S.chore.some(onDay)?S.chore.filter(onDay).sort((a,b)=>(done(a)?1:0)-(done(b)?1:0)).map(x=>{const d=isT()&&done(x);return `<div class="it ${d?'dn':''}"><label><input type=checkbox ${d?'checked':''} ${isT()?'':'disabled'} onchange="tg('chore','${x.id}')"><span>${esc(x.t)}<small>${sub(x)}${x.al?'، آلارم '+ft(x.tm):''}</small></span></label>${xb('chore',x.id)}</div>`}).join(''):empty('کاری ثبت نشده. مثلاً «آبیاری گل‌ها» هر هفته.'))
};

const LN=()=>window.Capacitor&&Capacitor.Plugins&&Capacitor.Plugins.LocalNotifications;
async function sched(r){const L=LN();if(!L)return;try{await L.requestPermissions();const ns=[];
[...new Set([ed(r),0])].forEach((k,i)=>{const at=new Date(dt(r.w).getTime()-k*864e5);const[h,mi]=(r.al&&r.tm||'09:00').split(':').map(Number);at.setHours(h,mi,0,0);if(at>Date.now())ns.push({id:r.n+i,title:r.al?'آلارم همراه خانه':'همراه خانه',body:k?fa(k)+' روز دیگر: '+r.t:'امروز: '+r.t,...(r.al?{channelId:'alarm'}:{}),schedule:{at,allowWhileIdle:!!r.al}})});
if(r.al)await mkch(L);
if(ns.length)await L.schedule({notifications:ns})}catch(e){}}
async function unsched(r){const L=LN();if(L)try{await L.cancel({notifications:[{id:r.n},{id:r.n+1}]})}catch(e){}}

const jp=d=>{const p={};new Intl.DateTimeFormat('fa-IR-u-ca-persian-nu-latn',{year:'numeric',month:'numeric',day:'numeric'}).formatToParts(d).forEach(x=>p[x.type]=+x.value);return p};
const jk=d=>{const p=cp(d);return p.year*100+p.month};
async function monthly(){const L=LN();if(!L)return;try{
await L.cancel({notifications:[1,2,3].map(i=>({id:2e9+i}))});
if(!S.cm)return;
const ns=[];let d=new Date();
for(let n=0;n<130&&ns.length<3;n++,d=new Date(d.getTime()+864e5)){
const nx=new Date(d.getTime()+864e5);if(cp(d).month==cp(nx).month)continue;
const at=new Date(d);at.setHours(9,0,0,0);if(at<=Date.now())continue;
const k=jk(nx),ch=S.rem.filter(x=>!x.ok&&x.c=='چک'&&jk(dt(x.w))==k).sort((a,b)=>a.w.localeCompare(b.w));
if(!ch.length)continue;
ns.push({id:2e9+ns.length+1,title:'چک‌های ماه بعد',body:'این چک‌ها ماه بعد سررسید دارن: '+ch.slice(0,5).map(x=>x.t+' ('+jd(x.w,{day:'numeric',month:'long'})+')').join('، ')+(ch.length>5?' و '+fa(ch.length-5)+' مورد دیگه':''),schedule:{at}})}
if(ns.length){await L.requestPermissions();await L.schedule({notifications:ns})}}catch(e){}}
const ft=s=>s.replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d]);
const alr=()=>`<div class=jd><label class=ck><input type=checkbox id=al><span>آلارم</span></label><input id=tn onfocus="this.select()" onclick="this.select()" oninput="lim(this,59)" onblur="this.value=this.value.padStart(2,'0')" type=text inputmode=numeric maxlength=2 dir=ltr placeholder="دقیقه" value="00" aria-label="دقیقه"><b>:</b><input id=th onfocus="this.select()" onclick="this.select()" oninput="lim(this,23);if(this.value.length>=2)g('tn').focus()" onblur="this.value=this.value.padStart(2,'0')" type=text inputmode=numeric maxlength=2 dir=ltr placeholder="ساعت" value="09" aria-label="ساعت"></div>`;
const mkch=L=>L.createChannel({id:'alarm',name:'آلارم',description:'آلارم یادآورها و کارها',importance:5,visibility:1,vibration:true}).catch(()=>{});
async function ssched(x){const L=LN();if(!L||!x.al)return;try{const at=dt(x.w),[h,m]=x.tm.split(':').map(Number);at.setHours(h,m,0,0);if(at<=Date.now())return;await L.requestPermissions();await mkch(L);
await L.schedule({notifications:[{id:x.n,title:'آلارم خرید',body:x.t,channelId:'alarm',schedule:{at,allowWhileIdle:true}}]})}catch(e){}}
async function cunsched(c){const L=LN();if(L&&c.n)try{await L.cancel({notifications:[0,1,2,3,4,5,6].map(d=>({id:c.n+d}))})}catch(e){}}
async function csched(c){await cunsched(c);const L=LN();if(!L||!c.al||!c.n)return;try{await L.requestPermissions();await mkch(L);const[h,m]=(c.tm||'09:00').split(':').map(Number);
await L.schedule({notifications:(c.ds||[0,1,2,3,4,5,6]).map(d=>({id:c.n+d,title:'آلارم همراه خانه',body:c.t,channelId:'alarm',schedule:{on:{weekday:d+1,hour:h,minute:m},allowWhileIdle:true}}))})}catch(e){}}
const find=(k,id)=>S[k].find(x=>x.id==id);
function tg(k,id){const x=find(k,id);
if(k=='chore')x.l=done(x)?'':T;else{x.ok=x.ok?0:1;if(k=='rem')x.ok?unsched(x):sched(x);if(k=='shop'&&x.n)x.ok?unsched(x):ssched(x)}
save();render()}
function rm(k,id){if(k=='rem')unsched(find(k,id));if(k=='chore')cunsched(find(k,id));if(k=='shop'){const x=find(k,id);if(x&&x.n)unsched(x)}S[k]=S[k].filter(x=>x.id!=id);save();render()}
function tcal(){S.cal=S.cal=='g'?'j':'g';save();render()}
function tcm(){S.cm=S.cm?0:1;save();render()}
function clr(){S.shop=S.shop.filter(x=>!x.ok);save();render()}
function add(k){const t=val('t');
if(k=='exp'){const a=num(val('a'));if(!a)return g('a').focus();S.exp.push({id:uid(),a,c:val('c'),t,w:T})}
else{if(!t)return g('t').focus();
